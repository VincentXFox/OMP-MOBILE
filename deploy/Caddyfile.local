{
	auto_https off
	admin off
}
https://192.0.2.10:8443, https://thor1.local:8443 {
	tls {$HOME}/omp-mobile/certs/leaf.crt {$HOME}/omp-mobile/certs/leaf.key
	# collab-релей (WebSocket /r/<room>) — отдельно от PWA, иначе WS не апгрейдится
	handle /r/* {
		reverse_proxy 127.0.0.1:7466
	}
	handle {
		reverse_proxy 127.0.0.1:8088
	}
}
