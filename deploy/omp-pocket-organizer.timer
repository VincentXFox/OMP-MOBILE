[Unit]
Description=Суточная раскладка агентов по папкам штата (04:00, догоняет пропущенное)

[Timer]
OnCalendar=*-*-* 04:00
# Ноутбук мог быть выключен в 4 утра — прогон делается при первом включении.
Persistent=true
# Разброс, чтобы раскладка не совпадала с другими суточными задачами минута в минуту.
RandomizedDelaySec=900

[Install]
WantedBy=timers.target
