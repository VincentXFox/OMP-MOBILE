[Unit]
Description=OMP Pocket runtime — панели терминалов (PTY и эмуляция экрана)
After=default.target

[Service]
Type=simple
WorkingDirectory=%h/omp-mobile/gateway
ExecStart=%h/.bun/bin/bun %h/omp-mobile/gateway/runtime/main.ts
# Демон держит панели агентов: рестарт шлюза его не трогает, а сам он поднимается сам.
Restart=always
RestartSec=2
# omp живёт в ~/.local/bin (панели запускают его голым именем), bun — в ~/.bun/bin
Environment=HOME=%h
Environment=PATH=%h/.local/bin:%h/.bun/bin:/usr/local/bin:/usr/bin:/bin
# Сокет — в XDG_RUNTIME_DIR (оттуда же его берёт шлюз), состояние панелей — в XDG_STATE_HOME.
Environment=OMP_RUNTIME_SOCKET=%t/omp-pocket-runtime.sock
Environment=OMP_RUNTIME_STATE_DIR=%h/.local/state/omp-pocket/runtime

[Install]
WantedBy=default.target
